# ==============================================================================
# NexaDesk-RAG Backend Environment Variables Example
# Duplicate this file to .env in backend directory and adjust values as needed.
# ==============================================================================

# Application Settings
PROJECT_NAME="NexaDesk RAG Customer Enquiry System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==============================================================================
# LLM Provider Configuration (Interchangeable: "gemini" or "ollama")
# ==============================================================================
LLM_PROVIDER="gemini"

# 1. Google Gemini Provider Settings
GEMINI_API_KEY="your_gemini_api_key_placeholder"
GEMINI_MODEL="gemini-1.5-flash"

# 2. Ollama Local Provider Settings (Optional local offline LLM)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TIMEOUT=60

# Storage & Persistence Paths
CHROMA_PERSIST_DIRECTORY="storage/chroma_db"
UPLOADS_DIRECTORY="storage/uploads"
DOCUMENTS_DIRECTORY="data/documents/NexaDesk"
SQLITE_DB_PATH="app/database/nexadesk.db"

# Product Versioning Configuration
DEFAULT_PRODUCT_VERSION="v3.0"
SUPPORTED_PRODUCT_VERSIONS="v1.0,v2.0,v3.0"

